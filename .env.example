# ── Ollama / LLM ─────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=120

# ── Embeddings ───────────────────────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── RAG ──────────────────────────────────────────────────────────────
RAG_TOP_K=5
CHUNK_SIZE=300
CHUNK_OVERLAP=50

# ── Safety ───────────────────────────────────────────────────────────
EMERGENCY_SIMILARITY_THRESHOLD=0.72

# ── CORS / Frontend ─────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:5173

# ── Logging ──────────────────────────────────────────────────────────
LOG_DIR=./backend/logs
